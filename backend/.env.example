# Razorpay (Test Mode) credentials
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# WAL Sidecar (optional). Set this to route Razorpay API calls through the
# local WAL sidecar (run separately: uvicorn sidecar.main:app --port 9000).
# Leave unset/empty to call Razorpay directly (sidecar disabled).
# WAL_SIDECAR_URL=http://localhost:9000

# Groq API
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=resync

# App
FRONTEND_ORIGIN=http://localhost:5173
SAFETY_MAX_AMOUNT_INR=10000
SAFETY_MIN_CONFIDENCE=0.85
