# MongoDB.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=resync

# Safety gate thresholds for the healing agent.
SAFETY_MAX_AMOUNT_INR=10000
SAFETY_MIN_CONFIDENCE=0.85
