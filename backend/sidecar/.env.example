# WAL Sidecar -- standalone process settings.
# Copy to backend/sidecar/.env and fill in.

# Real Razorpay API this sidecar relays requests to.
RAZORPAY_UPSTREAM_URL=https://api.razorpay.com

# Groq API (used by the sidecar's own self-healing agent)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# MongoDB -- same database the main backend uses (both approaches heal
# the same merchant database, independently).
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=resync

# Safety gate thresholds for this sidecar's own healing agent.
SAFETY_MAX_AMOUNT_INR=10000
SAFETY_MIN_CONFIDENCE=0.85
